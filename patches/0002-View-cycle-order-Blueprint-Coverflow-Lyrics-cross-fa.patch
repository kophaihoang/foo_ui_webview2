diff --git a/src/immersive/coverflow/shuffleLookahead.ts b/src/immersive/coverflow/shuffleLookahead.ts
new file mode 100644
index 0000000..5f4780a
--- /dev/null
+++ b/src/immersive/coverflow/shuffleLookahead.ts
@@ -0,0 +1,67 @@
+import { fb } from 'foo-webview-sdk/bridge';
+import { useAtomValueRawSync } from 'jotai/react';
+import { useEffect, useRef } from 'react';
+import { currentTrackAtom, playbackOrderAtom } from '../../playback/playback.ts';
+import { queueViewAtom } from '../../playback/queue/queueState.ts';
+
+/** How many songs the coverflow keeps lined up on its right while a random order is on */
+const LOOKAHEAD = 6;
+const RANDOM_ORDERS = new Set(['random', 'shuffle-tracks', 'shuffle-albums', 'shuffle-folders']);
+
+/**
+ * In a random playback order foobar2000 decides the next song only when the current one ends, so there is
+ * nothing to show on the right of the coverflow. While the coverflow is open this picks the upcoming songs
+ * itself, at random from the playing playlist, and puts them in the playback queue: they show up on the right
+ * and are really what plays next. The queue is only topped up, never cleared, and songs already in it count.
+ */
+export function useShuffleLookahead(enabled: boolean): void {
+  const order = useAtomValueRawSync(playbackOrderAtom);
+  const queued = useAtomValueRawSync(queueViewAtom).entries;
+  const current = useAtomValueRawSync(currentTrackAtom);
+  const busy = useRef(false);
+  // the queue view catches up a moment after an add; don't add again before it has
+  const lastAdd = useRef(0);
+  const random = order !== null && RANDOM_ORDERS.has(order);
+  const need = LOOKAHEAD - queued.length;
+  const taken = queued.map((entry) => entry.spot?.row ?? -1).join(',');
+
+  useEffect(() => {
+    if (!enabled || !random || need <= 0 || current === null) return;
+    let cancelled = false;
+    const timer = setTimeout(() => {
+      if (busy.current || Date.now() - lastAdd.current < 2000) return;
+      busy.current = true;
+      void (async () => {
+        try {
+          const playing = await fb.player.getPlayingPlaylist();
+          if (cancelled || !playing.success || !playing.found || playing.playlistGuid === null) return;
+          const guid = playing.playlistGuid;
+          const counted = await fb.playlist.getCount(guid);
+          if (cancelled || !counted.success || counted.count < 2) return;
+          const at = await fb.player.getCurrentTrackIndex();
+          const skip = new Set(taken.split(',').map(Number));
+          if (at.success && at.found && at.index !== null) skip.add(at.index);
+          const free = counted.count - skip.size;
+          const rows: number[] = [];
+          for (let tries = 0; rows.length < Math.min(need, free) && tries < need * 20; tries++) {
+            const row = Math.floor(Math.random() * counted.count);
+            if (skip.has(row)) continue;
+            skip.add(row);
+            rows.push(row);
+          }
+          if (cancelled || rows.length === 0) return;
+          lastAdd.current = Date.now();
+          await fb.queue.add({ playlistGuid: guid, tracks: rows });
+        } catch {
+          // the host went away or refused; the coverflow simply shows what it has
+        } finally {
+          busy.current = false;
+        }
+      })();
+    }, 350);
+    return () => {
+      cancelled = true;
+      clearTimeout(timer);
+    };
+  }, [enabled, random, need, taken, current]);
+}
