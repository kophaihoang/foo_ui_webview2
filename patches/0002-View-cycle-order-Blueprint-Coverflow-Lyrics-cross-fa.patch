-/** Blueprint → Lyrics */
+const OUT_MS = 170;
+const IN_MS = 320;
+const EASE_OUT = 'cubic-bezier(0.4, 0, 1, 1)';
+const EASE_IN = 'cubic-bezier(0.1, 0.9, 0.2, 1)';
+
+const nextFrame = () => new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
+
+/** Fade the view out, swap the scene, let the new scene measure itself, then fade it back in */
+async function fadeSwap(store: Store, update: () => void): Promise<void> {
+  const content = document.querySelector<HTMLElement>('[data-immersive-content]');
+  if (!content || store.get(reducedMotionAtom) || document.visibilityState !== 'visible') {
+    update();
+    return;
+  }
+  if (swapping) return;
+  swapping = true;
+  try {
+    await content
+      .animate(
+        [
+          { opacity: 1, transform: 'scale(1)', filter: 'blur(0px)' },
+          { opacity: 0, transform: 'scale(0.985)', filter: 'blur(6px)' },
+        ],
+        { duration: OUT_MS, easing: EASE_OUT, fill: 'forwards' },
+      )
+      .finished.catch(() => {});
+    update();
+    // the presets scene lays itself out from its measured box: give it two frames before showing it
+    await nextFrame();
+    await nextFrame();
+    for (const running of content.getAnimations()) running.cancel();
+    await content
+      .animate(
+        [
+          { opacity: 0, transform: 'scale(1.015)', filter: 'blur(6px)' },
+          { opacity: 1, transform: 'scale(1)', filter: 'blur(0px)' },
+        ],
+        { duration: IN_MS, easing: EASE_IN },
+      )
+      .finished.catch(() => {});
+  } finally {
+    swapping = false;
+  }
+}
