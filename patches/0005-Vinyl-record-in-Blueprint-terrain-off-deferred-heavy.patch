@@ -0,0 +1,57 @@
+.disc {
+  position: absolute;
+  border-radius: 50%;
+  background:
+    /* track gaps: a few slightly lighter, smoother bands between the songs */
+    radial-gradient(
+      circle,
+      transparent 0 44%,
+      rgba(255, 255, 255, 0.05) 44.3% 44.9%,
+      transparent 45.2% 59%,
+      rgba(255, 255, 255, 0.05) 59.3% 59.9%,
+      transparent 60.2% 75%,
+      rgba(255, 255, 255, 0.05) 75.3% 75.9%,
+      transparent 76.2%
+    ),
+    /* fine grooves */
+    repeating-radial-gradient(circle, #121214 0 1px, #19191c 1px 2px, #0c0c0e 2px 3px),
+    #101012;
+  box-shadow:
+    0 24px 60px rgba(0, 0, 0, 0.5),
+    0 0 0 1px rgba(255, 255, 255, 0.06),
+    inset 0 0 0 6px #0a0a0b,
+    inset 0 0 0 7px rgba(255, 255, 255, 0.07);
+  animation: disc-in 620ms cubic-bezier(0.1, 0.9, 0.2, 1) both;
+  pointer-events: none;
+}
+
+/* light catching the grooves: two opposite glints, the way a lamp shows on a real record */
+.sheen {
+  position: absolute;
+  inset: 0;
+  border-radius: 50%;
+  background: conic-gradient(
+    from 20deg,
+    transparent 0deg,
+    rgba(255, 255, 255, 0.13) 22deg,
+    transparent 48deg,
+    transparent 180deg,
+    rgba(255, 255, 255, 0.1) 202deg,
+    transparent 228deg,
+    transparent 360deg
+  );
+  mix-blend-mode: screen;
+}
+
+@keyframes disc-in {
+  from {
+    opacity: 0;
+    transform: scale(0.55);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .disc {
+    animation: none;
+  }
+}
