@@ -0,0 +1,33 @@
+import { fb } from 'foo-webview-sdk/bridge';
+import { settle } from '../../host/hostCall.ts';
+
+/**
+ * Keeps the window from being dragged anywhere below the top `strip` pixels while the immersive view is up.
+ *
+ * The host can treat parts of the page as window caption (a title-bar fallback, registered drag regions) and
+ * still hand the mouse to the page, so a drag that the page handles (moving a cover, scrubbing the waveform)
+ * also moved the window. A no-drag region over everything below the strip wins over those; it follows the
+ * window size and is taken away when the view closes. Returns the undo.
+ */
+export function lockWindowDrag(strip: number): () => void {
+  let disposed = false;
+  let frame = 0;
+  const apply = () => {
+    if (disposed) return;
+    const width = window.innerWidth;
+    const height = Math.max(0, window.innerHeight - strip);
