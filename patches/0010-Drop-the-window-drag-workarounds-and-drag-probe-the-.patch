-import { fb } from 'foo-webview-sdk/bridge';
-import { settle } from '../../host/hostCall.ts';
-
-/**
- * Keeps the window from being dragged anywhere below the top `strip` pixels while the immersive view is up.
- *
- * The host can treat parts of the page as window caption (a title-bar fallback, registered drag regions) and
- * still hand the mouse to the page, so a drag that the page handles (moving a cover, scrubbing the waveform)
- * also moved the window. A no-drag region over everything below the strip wins over those; it follows the
- * window size and is taken away when the view closes. Returns the undo.
- */
-export function lockWindowDrag(strip: number): () => void {
-  let disposed = false;
-  let frame = 0;
-  const apply = () => {
-    if (disposed) return;
-    const width = window.innerWidth;
-    const height = Math.max(0, window.innerHeight - strip);
-    void settle(() => fb.ui.setNoDragRegions([{ x: 0, y: strip, width, height }]));
-  };
-  const onResize = () => {
-    cancelAnimationFrame(frame);
-    frame = requestAnimationFrame(apply);
-  };
-  apply();
-  window.addEventListener('resize', onResize);
-  // the host also treats the top `titlebarHeight` pixels as caption when WebView2 has no answer for a point;
-  // shrink that to a sliver while the view is up and put it back after
-  let saved: number | null = null;
-  void settle(() => fb.ui.getTitlebarHeight()).then((answer) => {
-    if (disposed || !answer?.success) return;
-    saved = answer.height;
-    void settle(() => fb.ui.setTitlebarHeight(1));
-  });
-  return () => {
-    disposed = true;
-    cancelAnimationFrame(frame);
-    window.removeEventListener('resize', onResize);
-    void settle(() => fb.ui.clearNoDragRegions());
-    const height = saved;
-    if (height !== null) void settle(() => fb.ui.setTitlebarHeight(height));
-  };
-}
