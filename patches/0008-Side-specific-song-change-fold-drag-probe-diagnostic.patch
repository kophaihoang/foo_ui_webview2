diff --git a/src/immersive/page/DragProbe.tsx b/src/immersive/page/DragProbe.tsx
new file mode 100644
index 0000000..9199461
--- /dev/null
+++ b/src/immersive/page/DragProbe.tsx
@@ -0,0 +1,118 @@
+import { fb } from 'foo-webview-sdk/bridge';
+import { useEffect, useState } from 'react';
+import { settle } from '../../host/hostCall.ts';
+
+/**
+ * Diagnostic: finds out how the window gets moved while dragging inside the immersive view.
+ * It watches the window position and the mouse as the page sees it, and prints what it saw:
+ *  - whether the page got the press at all (a press the host turns into a window drag never reaches it)
+ *  - how many moves the page got while the button was down
+ *  - whether anything under the press point is marked as a CSS drag region
+ *  - how far the window moved
+ */
+export function DragProbe() {
+  const [lines, setLines] = useState<string[]>([
+    'probe ready: drag somewhere, then send a screenshot',
+  ]);
+  useEffect(() => {
+    let disposed = false;
+    let last: { x: number; y: number } | null = null;
+    let down: {
+      x: number;
+      y: number;
+      t: number;
+      moves: number;
+      target: string;
+      regions: string;
+    } | null = null;
+    const log = (line: string) => setLines((all) => [...all.slice(-7), line]);
+    const describe = (el: Element | null) =>
+      el
+        ? `${el.tagName.toLowerCase()}${el.className && typeof el.className === 'string' ? '.' + el.className.split(' ')[0] : ''}`
+        : '-';
+    const regionsAt = (x: number, y: number) =>
+      document
+        .elementsFromPoint(x, y)
+        .map(
+          (el) =>
+            getComputedStyle(el).getPropertyValue('app-region') ||
+            getComputedStyle(el).getPropertyValue('-webkit-app-region'),
+        )
+        .filter((v) => v && v !== 'none' && v !== 'no-drag')
+        .join(',') || 'none';
+    const onDown = (e: PointerEvent) => {
+      down = {
+        x: e.clientX,
+        y: e.clientY,
+        t: performance.now(),
+        moves: 0,
+        target: describe(e.target as Element),
+        regions: regionsAt(e.clientX, e.clientY),
+      };
+      log(
+        `DOWN at ${Math.round(e.clientX)},${Math.round(e.clientY)} on ${down.target} drag-css=${down.regions} type=${e.pointerType}`,
+      );
+    };
+    const onMove = (e: PointerEvent) => {
+      if (down && e.buttons & 1) down.moves++;
+    };
+    const onUp = (e: PointerEvent) => {
+      if (!down) return;
+      log(
+        `UP after ${Math.round(performance.now() - down.t)}ms, page got ${down.moves} moves (${e.type})`,
+      );
+      down = null;
+    };
+    const onLost = () => log('page lost pointer capture');
+    const onProbe = (e: Event) => log(String((e as CustomEvent).detail));
+    window.addEventListener('drag-probe', onProbe);
+    window.addEventListener('pointerdown', onDown, true);
+    window.addEventListener('pointermove', onMove, true);
+    window.addEventListener('pointerup', onUp, true);
+    window.addEventListener('pointercancel', onUp, true);
+    window.addEventListener('lostpointercapture', onLost, true);
+    const poll = setInterval(() => {
+      void settle(() => fb.ui.getBounds()).then((b) => {
+        if (disposed || !b?.success) return;
+        if (last && (b.x !== last.x || b.y !== last.y)) {
+          log(
+            `WINDOW MOVED ${b.x - last.x},${b.y - last.y} ${down ? `(page sees press, ${down.moves} moves)` : '(page sees NO press)'}`,
+          );
+        }
+        last = { x: b.x, y: b.y };
+      });
+    }, 120);
+    return () => {
+      disposed = true;
+      clearInterval(poll);
+      window.removeEventListener('pointerdown', onDown, true);
+      window.removeEventListener('pointermove', onMove, true);
+      window.removeEventListener('pointerup', onUp, true);
+      window.removeEventListener('pointercancel', onUp, true);
+      window.removeEventListener('lostpointercapture', onLost, true);
+      window.removeEventListener('drag-probe', onProbe);
+    };
+  }, []);
+  return (
+    <pre
+      aria-hidden
+      style={{
+        position: 'absolute',
+        left: 12,
+        bottom: 12,
+        zIndex: 9999,
+        margin: 0,
+        padding: '8px 10px',
+        maxWidth: '70%',
+        whiteSpace: 'pre-wrap',
+        font: '11px/1.4 Consolas, monospace',
+        color: '#bff',
+        background: 'rgba(0,0,0,0.72)',
+        borderRadius: 8,
+        pointerEvents: 'none',
+      }}
+    >
+      {lines.join('\n')}
+    </pre>
+  );
+}
