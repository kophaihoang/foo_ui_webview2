diff --git a/src/immersive/coverflow/Coverflow.tsx b/src/immersive/coverflow/Coverflow.tsx
index a059cb6..df8f374 100644
--- a/src/immersive/coverflow/Coverflow.tsx
+++ b/src/immersive/coverflow/Coverflow.tsx
@@ -252,17 +252,28 @@ export function Coverflow({ leaving = false }: CoverflowProps) {
     engine.setReduced(reduced);
   });
   // 焦点或条目序列变更时触发补间位移
-  const prior = useRef<{ keys: readonly string[]; selected: number } | null>(null);
+  const prior = useRef<{
+    keys: readonly string[];
+    selected: number;
+    playing: string | null;
+  } | null>(null);
   useLayoutEffect(() => {
     settle.current = () => setSpan({ from: selected, to: selected });
     const keys = items.map((item) => item.key);
     const before = prior.current;
-    prior.current = { keys, selected };
+    const playing = items[currentAt]?.track?.handle ?? null;
+    prior.current = { keys, selected, playing };
     // 退场期间保持视心位置固定，避免关闭模式时因重置为当前曲目而产生滚动
     if (leaving && before) return;
     if (!before) {
       engine.jumpTo(selected);
       if (!leaving) engine.enter(selected);
+    } else if (before.playing !== playing && selected === currentAt) {
+      // a new song while following playback: the side covers fold back behind the playing cover and fan out
+      // again around the new one, like opening the view, instead of the whole row sliding over
+      engine.jumpTo(selected);
+      engine.regather(selected);
+      setSpan({ from: selected, to: selected });
     } else if (!sameKeys(before.keys, keys)) {
       engine.rekey(before.keys, keys, selected);
       setSpan({ from: engine.position(), to: selected });
@@ -272,7 +283,7 @@ export function Coverflow({ leaving = false }: CoverflowProps) {
       engine.goTo(selected);
       setSpan({ from, to: selected });
     }
-  }, [engine, items, selected, leaving]);
+  }, [engine, items, selected, leaving, currentAt]);
   // 提交后重绘以避免新挂载卡片首帧位置闪烁
   useLayoutEffect(() => {
     engine.paint();
