diff --git a/src/immersive/page/windowDragLock.ts b/src/immersive/page/windowDragLock.ts
index cfe974a..409ca06 100644
--- a/src/immersive/page/windowDragLock.ts
+++ b/src/immersive/page/windowDragLock.ts
@@ -24,10 +24,20 @@ export function lockWindowDrag(strip: number): () => void {
   };
   apply();
   window.addEventListener('resize', onResize);
+  // the host also treats the top `titlebarHeight` pixels as caption when WebView2 has no answer for a point;
+  // shrink that to a sliver while the view is up and put it back after
+  let saved: number | null = null;
+  void settle(() => fb.ui.getTitlebarHeight()).then((answer) => {
+    if (disposed || !answer?.success) return;
+    saved = answer.height;
+    void settle(() => fb.ui.setTitlebarHeight(1));
+  });
   return () => {
     disposed = true;
     cancelAnimationFrame(frame);
     window.removeEventListener('resize', onResize);
     void settle(() => fb.ui.clearNoDragRegions());
+    const height = saved;
+    if (height !== null) void settle(() => fb.ui.setTitlebarHeight(height));
   };
 }
