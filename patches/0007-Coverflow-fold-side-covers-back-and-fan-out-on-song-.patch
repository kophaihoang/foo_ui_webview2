   let cancel: (() => void) | null = null;
   // 每张卡的点亮系数，0 到 1：只有浏览的落点那一张（序号等于 `rest`）朝 1 走，别的朝 0 走。
   // 没有点亮的封面经过中间位置也保持压暗，滚动时一张张掠过不会一闪一闪地变亮，只有确定的落点才亮起来
@@ -126,6 +134,7 @@ export function createCoverflowEngine(
