       const now = clock.now();
       paintAt(now);
+      if (gather && now - gather.start >= GATHER_MS) {
+        const { center } = gather;
+        gather = null;
+        startIntro(center, now - (ENTRY_DELAY_MS - REGATHER_DELAY_MS));
+      }
       if (animating(now)) schedule();
       else settle(now);
     });
   }
 
+  function startIntro(center: number, start: number): void {
+    const ranks = new Map<string, number>();
