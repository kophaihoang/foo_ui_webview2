+
+/** Lyrics → Blueprint: into the record's label (or the narrow tier's square cover) */
+export function flyIntoBlueprint(store: Store, update: () => void): boolean {
+  return flyCover(store, {
+    landing: (content) => paperCoverBox(content.clientWidth, content.clientHeight),
+    leaving: (content) => content.querySelector<HTMLElement>('[data-scene]'),
+    update,
+    entering: (content) => content.querySelector<HTMLElement>('[data-scene="paper"]'),
+    cover: (content) => content.querySelector<HTMLElement>('[data-dial-cover]'),
+  });
+}
+
+/**
+ * Where the split preset (the lyrics view) puts its cover. The preset is in the page already, hidden while
+ * the coverflow is up, with its measures written on it (`SplitPreset`): the cover column takes 0.45 of the
+ * width (plus the reach into the sidebar), or all of it when centred; the cover sits centred in the column at
+ * the stack's top.
+ */
+/** The split preset's own root; the presets scene's root carries the preset id too */
+const SPLIT = '[data-scene="presets"] [data-preset="split"]';
+
+function splitCoverBox(content: HTMLElement): LandingBox | null {
+  const split = content.querySelector<HTMLElement>(SPLIT);
+  const scene = content.querySelector<HTMLElement>('[data-scene="presets"]');
+  if (!split || !scene) return null;
+  const style = split.style;
+  const width = parseFloat(style.width);
+  const cover = parseFloat(style.getPropertyValue('--split-cover'));
+  const top = parseFloat(style.getPropertyValue('--split-stack-top'));
+  const reach = parseFloat(style.getPropertyValue('--split-reach')) || 0;
+  if (![width, cover, top].every(Number.isFinite)) return null;
+  const scale = Number(/scale\(([\d.]+)\)/.exec(style.transform)?.[1] ?? 1) || 1;
+  const column = split.hasAttribute('data-centered') ? width : width * 0.45 + reach;
+  const contentBox = content.getBoundingClientRect();
+  const sceneBox = scene.getBoundingClientRect();
+  const zoom = contentBox.width / content.clientWidth || 1;
+  return {
+    left: (sceneBox.left - contentBox.left) / zoom + ((column - cover) / 2) * scale,
+    top: (sceneBox.top - contentBox.top) / zoom + top * scale,
+    size: cover * scale,
+    round: false,
+    radius: 12,
+  };
+}
+
+/** Coverflow → Lyrics: from the middle card to the lyrics view's cover */
+export function flyIntoLyrics(store: Store, update: () => void): boolean {
+  return flyCover(store, {
+    landing: splitCoverBox,
+    leaving: (content) => content.querySelector<HTMLElement>('[data-stage="coverflow"]'),
+    update,
+    entering: (content) => content.querySelector<HTMLElement>(SPLIT),
+    cover: (content) =>
+      content.querySelector<HTMLElement>('[data-preset="split"] [data-scene-element="cover"]'),
+  });
+}
