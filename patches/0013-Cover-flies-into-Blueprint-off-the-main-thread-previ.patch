+/* The cover's copy flying into Blueprint (`coverFlight.ts`): above the scenes, never in the way of the pointer.
+   Only its transform and the two layers' opacity animate, so the compositor runs the whole flight. */
+.plane {
+  position: fixed;
+  left: 0;
+  top: 0;
+  z-index: 3;
+  transform-origin: 0 0;
+  pointer-events: none;
+  will-change: transform;
+}
+
+.square,
+.round {
+  position: absolute;
+  inset: 0;
+  overflow: hidden;
+  background: var(--colorNeutralBackground3);
+}
+
+.square {
+  box-shadow: 0 16px 48px var(--colorNeutralShadowKeyDarker);
+}
+
+/* the record's label, as `DialCover`'s round cover draws it */
+.round {
+  opacity: 0;
+  border-radius: 50%;
+  box-shadow:
+    0 0 0 calc(var(--ring, 1px) * 2) rgba(0, 0, 0, 0.55),
+    0 0 0 calc(var(--ring, 1px) * 3) rgba(255, 255, 255, 0.08);
+}
+
+.square img,
+.round img {
+  position: absolute;
+  inset: 0;
